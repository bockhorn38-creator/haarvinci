# Nur eine Vorlage. scripts/setup.sh erzeugt lokale Geheimnisse automatisch.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=haarvinci
POSTGRES_USER=haarvinci
POSTGRES_PASSWORD=
POSTGRES_PORT=54329
# Für externes PostgreSQL alternativ DATABASE_URL setzen, mit TLS im Internet.
# DATABASE_URL=postgresql://user:password@host:5432/haarvinci?sslmode=require
# Produktion: DJANGO_DEBUG=false, explizite Hosts und HTTPS-Ursprung.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://haarvinci.example
